<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Main Page</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      color: #12203a;
    }

    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 24px;
      background: #12203a;
      color: white;
    }

    nav ul {
      display: flex;
      gap: 20px;
      list-style: none;
    }

    nav a {
      color: white;
      text-decoration: none;
    }

    .btn {
      background: #ffb703;
      border: 0;
      padding: 8px 16px;
      border-radius: 6px;
      font-weight: bold;
    }

    .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      height: 260px;
      padding: 16px;
      text-align: center;
      background: #2f5bea;
      color: white;
    }

    .cards {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      padding: 24px;
    }

    .card {
      flex: 1 1 200px;
      background: #eef2ff;
      padding: 20px;
      border-radius: 10px;
      text-align: center;
    }
  </style>
</head>
<body>
  <nav>
    <strong>My Website</strong>
    <ul>
      <li><a href="#">Home</a></li>
      <li><a href="#">About</a></li>
      <li><a href="#">Contact</a></li>
    </ul>
    <button class="btn">Get Started</button>
  </nav>

  <main>
    <section class="hero">
      <h1>Welcome to My Website</h1>
      <p>Learn, create, and build something great.</p>
      <button class="btn">Explore</button>
    </section>

    <section class="cards">
      <article class="card">
        <h2>Learn</h2>
        <p>Discover new skills and ideas.</p>
      </article>
      <article class="card">
        <h2>Build</h2>
        <p>Turn your ideas into projects.</p>
      </article>
      <article class="card">
        <h2>Share</h2>
        <p>Show your work with others.</p>
      </article>
    </section>
  </main>
</body>
</html>